{
  "distance_influence": 70,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "road_access == DESTINATION || road_access == PRIVATE", "multiply_by": "0.1" },
    { "if": "max_weight < 40 || max_height < 4", "multiply_by": "0" },
    { "if": "road_class == RESIDENTIAL || road_class == LIVING_STREET || road_class == SERVICE", "multiply_by": "0.2" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" },
    { "if": "true", "limit_to": "85" }
  ]
}
